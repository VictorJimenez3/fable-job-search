# Core deterministic crawler (all optional unless noted by the command)
RADAR_PROFILE=new_grad
RADAR_WORKDAY_MAX_RESULTS=200
RADAR_PHENOM_MAX_RESULTS=100
RADAR_EIGHTFOLD_MAX_RESULTS=100
RADAR_SMARTRECRUITERS_MAX_RESULTS=1000

# Postgres vNext / Neon. Required only for `radar db ...`, the durable worker,
# and vNext transactional APIs. Use a pooled connection string on Vercel.
DATABASE_URL=

# Database-backed Better Auth v2. The secret must be random and >=32 chars.
BETTER_AUTH_URL=https://job-radar-newgrad.vercel.app
BETTER_AUTH_SECRET=
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Existing signed-cookie production auth remains supported during migration.
SESSION_SECRET=
AUTH_ALIAS_HOSTS=

# Optional maintained AI provider adapter. Set to `litellm` only after
# installing the `ai` extra. AI remains non-required.
RADAR_LLM_ADAPTER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Read-only email lifecycle tracking. Set to `gmail_api` for History API;
# leave blank for the existing IMAP path.
EMAIL_BACKEND=
GMAIL_REFRESH_TOKEN=
RADAR_GMAIL_MAX_MESSAGES=500
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com

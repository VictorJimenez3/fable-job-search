{
  "manifest_version": 3,
  "name": "Job Radar Application Finisher",
  "description": "Finishes employer applications after Simplify Copilot's autofill pass.",
  "version": "0.4.0",
  "permissions": ["alarms", "storage", "tabs", "nativeMessaging"],
  "host_permissions": [
    "http://127.0.0.1:4317/*",
    "http://localhost:4317/*",
    "https://job-radar-newgrad.vercel.app/*",
    "https://*.vercel.app/*",
    "https://*.greenhouse.io/*",
    "https://*.greenhouse.com/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "<all_urls>"
  ],
  "action": {"default_title": "Job Radar Finisher", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["ats-adapters.js", "content.js"],
    "run_at": "document_idle"
  }]
}
